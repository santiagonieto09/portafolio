# Token personal de GitHub (opcional).
# Aumenta el límite de peticiones a la API (5000/hora en lugar de 60/hora).
# Se usa solo en el servidor; nunca se expone al cliente.
GITHUB_TOKEN=

# Secreto compartido para proteger el endpoint de sincronización POST /api/public/sync.
# Debe coincidir con el header `x-cron-secret` (o `Authorization: Bearer`) del cron.
CRON_SECRET=

# URL pública del sitio (se usa en el sitemap).
# Si no se define, el sitemap la deriva del origin de la propia petición.
SITE_URL=
